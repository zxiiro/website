---
import ThemeToggle from "./ThemeToggle.astro";
import { profile } from "../data/profile";

const links = [
  { href: "#experience", label: "Experience" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 border-b border-[color:var(--color-border)] bg-[color:var(--color-bg)]/80 backdrop-blur supports-[backdrop-filter]:bg-[color:var(--color-bg)]/60">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="#top" class="font-mono text-sm tracking-tight text-[color:var(--color-fg)] hover:text-[color:var(--color-accent)] transition">
      <span class="text-[color:var(--color-accent)]">~/</span>{profile.handle}
    </a>
    <nav class="flex items-center gap-1">
      <ul class="hidden sm:flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="rounded-md px-3 py-1.5 text-sm text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)] hover:bg-[color:var(--color-bg-elevated)] transition"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="ml-1">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>
