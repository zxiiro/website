---
import ThemeToggle from "./ThemeToggle.astro";
import { profile } from "../data/profile";

const links: { href: string; label: string; emphasized?: boolean }[] = [
  { href: "#experience", label: "Experience" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
  { href: "/resume", label: "Resume", emphasized: true },
];
---

<header class="sticky top-0 z-40 border-b border-[color:var(--color-border)] bg-[color:var(--color-bg)]/80 backdrop-blur supports-[backdrop-filter]:bg-[color:var(--color-bg)]/60">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="#top" class="zx-wordmark text-lg hover:opacity-80 transition" aria-label="zxiiro">
      Z<span class="zx-wordmark__accent">x</span>iiro
    </a>
    <nav class="flex items-center gap-1">
      <ul class="hidden sm:flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class={
                l.emphasized
                  ? "ml-1 rounded-full border border-[color:var(--color-accent)] px-3 py-1 text-sm text-[color:var(--color-accent)] hover:bg-[color:var(--color-accent)] hover:text-[color:var(--color-accent-fg)] transition"
                  : "rounded-md px-3 py-1.5 text-sm text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-fg)] hover:bg-[color:var(--color-bg-elevated)] transition"
              }
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="ml-1">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>
