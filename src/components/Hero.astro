---
import SocialIcons from "./SocialIcons.astro";
import { profile } from "../data/profile";
---

<section id="top" class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-60 dark:opacity-40"
    aria-hidden="true"
    style="background: radial-gradient(60% 60% at 30% 20%, color-mix(in oklch, var(--color-accent) 18%, transparent), transparent 70%), radial-gradient(50% 50% at 80% 10%, color-mix(in oklch, var(--color-accent) 10%, transparent), transparent 70%);"
  >
  </div>

  <div class="mx-auto max-w-3xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-20">
    <div class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center sm:gap-10">
      <div class="flex-1">
        <p class="font-mono text-sm text-[color:var(--color-accent)]">Hi, I'm</p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">
          {profile.name}
        </h1>
        <p class="mt-3 text-lg text-[color:var(--color-fg-muted)]">
          {profile.title} · {profile.location}
        </p>
        <p class="mt-6 max-w-prose text-[color:var(--color-fg)] leading-relaxed">
          {profile.bio}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="#contact"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-accent)] px-5 py-2.5 text-sm font-medium text-[color:var(--color-accent-fg)] shadow-sm transition hover:opacity-90"
          >
            Get in touch
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="#experience"
            class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] px-5 py-2.5 text-sm font-medium text-[color:var(--color-fg)] transition hover:border-[color:var(--color-accent)]"
          >
            View experience
          </a>
          <SocialIcons />
        </div>
      </div>

      <div class="shrink-0">
        <div class="relative">
          <div
            class="absolute -inset-1 rounded-full opacity-50 blur-lg"
            aria-hidden="true"
            style="background: conic-gradient(from 180deg at 50% 50%, var(--color-accent), transparent 60%);"
          >
          </div>
          <img
            src="/me.jpg"
            alt={profile.name}
            width="160"
            height="160"
            class="relative h-32 w-32 rounded-full object-cover ring-2 ring-[color:var(--color-border)] sm:h-40 sm:w-40"
          />
        </div>
      </div>
    </div>
  </div>
</section>
