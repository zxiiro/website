---
import SectionHeading from "./SectionHeading.astro";
import { skills } from "../data/skills";
---

<section id="skills" class="border-t border-[color:var(--color-border)]">
  <div class="mx-auto max-w-3xl px-6 py-20">
    <SectionHeading
      eyebrow="Skills"
      title="Tools of the trade"
      description="Day-to-day stack across automation, CI, and documentation."
    />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {skills.map((group) => (
        <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-5">
          <h3 class="text-sm font-medium text-[color:var(--color-fg)]">{group.title}</h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {group.skills.map((s) => (
              <li class="rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-bg)] px-2.5 py-1 font-mono text-xs text-[color:var(--color-fg-muted)]">
                {s}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
