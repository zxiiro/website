---
import SocialIcons from "./SocialIcons.astro";
import { profile } from "../data/profile";
import { skills } from "../data/skills";
---

<aside
  class="resume-sidebar border-b border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] lg:sticky lg:top-0 lg:h-screen lg:overflow-y-auto lg:border-b-0 lg:border-r"
>
  <div class="mx-auto max-w-md px-6 py-10 sm:px-8 sm:py-12 lg:max-w-none">
    <!-- Identity block -->
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-[color:var(--color-fg)] sm:text-3xl">
        {profile.name}
      </h1>
      <p class="mt-1 text-sm text-[color:var(--color-accent)]">
        {profile.title}
      </p>
      <p class="mt-2 flex items-center gap-1.5 text-xs text-[color:var(--color-fg-subtle)]">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        {profile.location}
      </p>
    </div>

    <!-- Bio -->
    <p class="mt-6 text-sm leading-relaxed text-[color:var(--color-fg-muted)]">
      {profile.bio}
    </p>

    <!-- Contact -->
    <section class="mt-8">
      <h2 class="resume-section-label">Contact</h2>
      <SocialIcons variant="row" size="sm" />
    </section>

    <!-- Skills -->
    <section class="mt-8">
      <h2 class="resume-section-label">Skills</h2>
      <div class="space-y-4">
        {skills.map((group) => (
          <div>
            <h3 class="text-xs font-medium uppercase tracking-wider text-[color:var(--color-fg-subtle)]">
              {group.title}
            </h3>
            <p class="mt-1 text-sm leading-relaxed text-[color:var(--color-fg)]">
              {group.skills.join(" · ")}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="mt-8">
      <h2 class="resume-section-label">Education</h2>
      <p class="text-sm text-[color:var(--color-fg)]">{profile.education.degree}</p>
      <p class="mt-0.5 text-xs text-[color:var(--color-fg-muted)]">
        {profile.education.school} · {profile.education.year}
      </p>
      {profile.education.note && (
        <p class="mt-0.5 text-xs text-[color:var(--color-fg-subtle)]">
          {profile.education.note}
        </p>
      )}
    </section>

    <!-- Interests -->
    <section class="mt-8">
      <h2 class="resume-section-label">Interests</h2>
      <p class="text-sm text-[color:var(--color-fg-muted)]">{profile.interests}</p>
    </section>
  </div>
</aside>
