---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="mb-10">
  <p class="font-mono text-xs uppercase tracking-widest text-[color:var(--color-accent)]">
    {eyebrow}
  </p>
  <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  {description && (
    <p class="mt-2 text-[color:var(--color-fg-muted)]">{description}</p>
  )}
</div>
