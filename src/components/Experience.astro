---
import SectionHeading from "./SectionHeading.astro";
import { experience } from "../data/experience";
---

<section id="experience" class="border-t border-[color:var(--color-border)]">
  <div class="mx-auto max-w-3xl px-6 py-20">
    <SectionHeading
      eyebrow="Experience"
      title="A career in release engineering & open source"
      description="Roles in build automation, CI infrastructure, and community leadership — most recent first."
    />

    <ol class="relative">
      {experience.map((role, i) => (
        <li class="group relative pl-8 pb-10 last:pb-0">
          <span
            class="absolute left-0 top-1 inline-flex h-3 w-3 -translate-x-1/2 rounded-full border-2 border-[color:var(--color-accent)] bg-[color:var(--color-bg)]"
            aria-hidden="true"
          ></span>
          {i < experience.length - 1 && (
            <span
              class="absolute left-0 top-4 -ml-px h-full w-px bg-[color:var(--color-border)]"
              aria-hidden="true"
            ></span>
          )}

          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h3 class="text-base font-medium text-[color:var(--color-fg)]">
              {role.title}
              <span class="text-[color:var(--color-fg-subtle)]"> · </span>
              <span class="text-[color:var(--color-fg-muted)]">{role.company}</span>
            </h3>
            <p class="font-mono text-xs text-[color:var(--color-fg-subtle)]">
              {role.start} — {role.end}
            </p>
          </div>

          <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-[color:var(--color-fg-muted)]">
            {role.bullets.map((b) => (
              <li class="relative pl-4 before:absolute before:left-0 before:top-2 before:h-1 before:w-1 before:rounded-full before:bg-[color:var(--color-fg-subtle)]">
                {b}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>
