---
import { experience } from "../data/experience";
---

<section id="experience">
  <h2 class="resume-section-label resume-section-label-lg">Experience</h2>

  <ol class="space-y-8 sm:space-y-10">
    {experience.map((role) => (
      <li class="break-inside-avoid">
        <header class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
          <h3 class="text-base font-medium text-[color:var(--color-fg)]">
            {role.title}
            <span class="text-[color:var(--color-fg-subtle)]"> · </span>
            <span class="text-[color:var(--color-accent)]">{role.company}</span>
          </h3>
          <p class="font-mono text-xs text-[color:var(--color-fg-subtle)]">
            {role.start} — {role.end}
          </p>
        </header>

        <ul class="mt-2.5 space-y-1 text-sm leading-relaxed text-[color:var(--color-fg-muted)]">
          {role.bullets.map((b) => (
            <li class="relative pl-4 before:absolute before:left-0 before:top-2 before:h-1 before:w-1 before:rounded-full before:bg-[color:var(--color-fg-subtle)]">
              {b}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>
