---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import ExperienceResume from "../components/ExperienceResume.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { profile } from "../data/profile";

const pillBtn =
  "inline-flex h-9 items-center gap-1.5 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] px-3 text-sm text-[color:var(--color-fg-muted)] transition hover:text-[color:var(--color-fg)] hover:border-[color:var(--color-accent)]";
---

<Layout title={`${profile.name} — Resume`} description={`${profile.title} resume — ${profile.location}`}>
  <!-- Floating controls (hidden on print) -->
  <div class="no-print fixed left-4 top-4 z-40 sm:left-6 sm:top-6">
    <a href="/" class={pillBtn}>
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7M19 12H5" />
      </svg>
      <span>Profile</span>
    </a>
  </div>

  <div class="no-print fixed right-4 top-4 z-40 flex items-center gap-2 sm:right-6 sm:top-6">
    <button
      id="reset-btn"
      type="button"
      class={pillBtn + " hidden"}
      aria-label="Reset excluded roles"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
        <path d="M3 3v5h5" />
      </svg>
      <span>Reset</span>
    </button>
    <button
      id="customize-btn"
      type="button"
      class={pillBtn}
      aria-label="Customize which roles appear in the printed resume"
    >
      <svg id="customize-icon-edit" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9" />
        <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
      </svg>
      <svg id="customize-icon-done" class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m5 12 5 5L20 7" />
      </svg>
      <span id="customize-label">Customize</span>
    </button>
    <button
      id="print-btn"
      type="button"
      class={pillBtn}
      aria-label="Print resume"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
        <rect x="6" y="14" width="12" height="8" rx="1" />
      </svg>
      <span class="hidden sm:inline">Print</span>
    </button>
    <ThemeToggle />
  </div>

  <div class="resume-layout lg:grid lg:min-h-screen lg:grid-cols-[340px_1fr] xl:grid-cols-[380px_1fr]">
    <Sidebar />

    <main class="resume-main">
      <div class="mx-auto max-w-2xl px-6 py-10 sm:px-10 sm:py-14 lg:py-16 xl:px-16">
        <ExperienceResume />

        <footer class="no-print mt-16 border-t border-[color:var(--color-border)] pt-6 text-center font-mono text-xs text-[color:var(--color-fg-subtle)]">
          © {new Date().getFullYear()} {profile.name}
        </footer>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  (function () {
    const STORAGE_KEY = "resume-excluded-roles";
    const root = document.documentElement;

    function load() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const arr = raw ? JSON.parse(raw) : [];
        return new Set(Array.isArray(arr) ? arr : []);
      } catch {
        return new Set();
      }
    }

    function save(set) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
      } catch {}
    }

    const excluded = load();

    function applyState() {
      const items = document.querySelectorAll(".role-item");
      items.forEach((el) => {
        const id = el.getAttribute("data-role-id");
        if (id && excluded.has(id)) {
          el.setAttribute("data-print-excluded", "true");
        } else {
          el.removeAttribute("data-print-excluded");
        }
      });
      const resetBtn = document.getElementById("reset-btn");
      if (resetBtn) {
        resetBtn.classList.toggle("hidden", excluded.size === 0);
      }
    }

    function setEditMode(on) {
      if (on) {
        root.setAttribute("data-edit-mode", "true");
      } else {
        root.removeAttribute("data-edit-mode");
      }
      const label = document.getElementById("customize-label");
      const editIcon = document.getElementById("customize-icon-edit");
      const doneIcon = document.getElementById("customize-icon-done");
      if (label) label.textContent = on ? "Done" : "Customize";
      if (editIcon) editIcon.classList.toggle("hidden", on);
      if (doneIcon) doneIcon.classList.toggle("hidden", !on);
    }

    document.addEventListener("DOMContentLoaded", () => {
      applyState();

      document.getElementById("print-btn")?.addEventListener("click", () => window.print());

      const customizeBtn = document.getElementById("customize-btn");
      customizeBtn?.addEventListener("click", () => {
        const isOn = root.getAttribute("data-edit-mode") === "true";
        setEditMode(!isOn);
      });

      document.getElementById("reset-btn")?.addEventListener("click", () => {
        excluded.clear();
        save(excluded);
        applyState();
      });

      document.querySelectorAll(".role-item").forEach((el) => {
        const id = el.getAttribute("data-role-id");
        if (!id) return;
        const btn = el.querySelector(".role-toggle");
        btn?.addEventListener("click", (e) => {
          e.preventDefault();
          if (excluded.has(id)) {
            excluded.delete(id);
          } else {
            excluded.add(id);
          }
          save(excluded);
          applyState();
        });
      });
    });
  })();
</script>
